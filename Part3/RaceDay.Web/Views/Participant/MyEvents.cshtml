@model List<RaceDay.Web.Models.EnrolmentInfo>
@{
    ViewData["Title"] = "My Events";
}
<div class="container py-4">
    <p class="rd-label">Your races</p>
    <h1 class="mb-4">My Events</h1>
    @if (Model.Count == 0)
    {
        <div class="rd-panel text-center">
            <h4>You have not enrolled in anything yet</h4>
            <p>Find a race and pick a category.</p>
            <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Browse events</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Event</th><th>Date</th><th class="d-none d-md-table-cell">Category</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.EventName<div class="small text-muted d-md-none">@e.CategoryName</div></td>
                            <td class="text-nowrap">@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td class="d-none d-md-table-cell">@e.CategoryName</td>
                            <td><partial name="_StatusBadge" model="e.StatusName" /></td>
                            <td><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId">View<span class="d-none d-md-inline"> event</span></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
