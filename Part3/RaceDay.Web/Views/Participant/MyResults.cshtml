@using RaceDay.Web.Models
@model List<ResultInfo>
@{
    ViewData["Title"] = "My Results";
}
<div class="container py-4">
    <p class="rd-label">Your race history</p>
    <h1 class="mb-4">My Results</h1>
    @if (Model.Count == 0)
    {
        <div class="rd-panel text-center">
            <h4>No results yet</h4>
            <p class="mb-0">Your results show here after an organiser publishes them.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.EventName</td>
                            <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@r.CategoryName</td>
                            <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                            <td><strong>@Lookups.Ordinal(r.FinishingPosition)</strong> out of @r.TotalFinishers finishers</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
