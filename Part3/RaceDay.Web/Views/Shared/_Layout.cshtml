@{
    // Who is logged in comes from the MVC session
    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("Name");
    var picture = Context.Session.GetString("Picture");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,600;1,700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-nav">
            <div class="container">
                <a class="navbar-brand rd-logo" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        @if (role == "Participant")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">Profile</a></li>
                        }
                        @if (role == "Organiser")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">My Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">Profile</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (role == null)
                        {
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-rd" asp-controller="Account" asp-action="Register">Register</a>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(picture))
                            {
                                <img src="@picture" class="rd-avatar" alt="Your profile picture" />
                            }
                            <span class="text-white me-2">@name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-outline-light btn-sm rounded-0">Logout</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @* Messages from the controllers show here on every page *@
        @if (TempData["Error"] != null || TempData["Success"] != null)
        {
            <div class="container mt-3">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger rounded-0" role="alert">@TempData["Error"]</div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success rounded-0" role="alert">@TempData["Success"]</div>
                }
            </div>
        }
        @RenderBody()
    </main>

    <div class="rd-finish" aria-hidden="true"></div>
    <footer class="rd-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="rd-logo mb-2">RACE<span>DAY</span></div>
                    <p>Find a race, sign up and track your results.</p>
                    <p class="mb-0">hello@raceday.co.za</p>
                </div>
                <div class="col-md-3">
                    <h5 class="rd-heading">Explore</h5>
                    <p class="mb-1"><a asp-controller="Home" asp-action="Index">Upcoming events</a></p>
                    <p class="mb-1"><a asp-controller="Account" asp-action="Register">Create an account</a></p>
                    <p class="mb-1"><a asp-controller="Account" asp-action="Login">Login</a></p>
                </div>
                <div class="col-md-4">
                    <h5 class="rd-heading">Event types</h5>
                    <p class="mb-1">Run, Walk, Cycle</p>
                    <p class="mb-1">Triathlon, Ultra Marathon</p>
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <small>&copy; 2026 RaceDay. Student project by Ives Mukadi.</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
