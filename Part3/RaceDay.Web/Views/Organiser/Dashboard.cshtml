@model List<RaceDay.Web.Models.EventInfo>
@{
    ViewData["Title"] = "Dashboard";
    var counts = (Dictionary<int, int>)ViewBag.Counts;
    var upcoming = Model.Where(e => e.Date >= DateTime.Now).OrderBy(e => e.Date).FirstOrDefault();
}
<div class="container py-4">
    <p class="rd-label">Organiser</p>
    <h1 class="mb-4">Dashboard</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="rd-stat-card"><small>Events created</small><div class="num">@Model.Count</div></div></div>
        <div class="col-md-4"><div class="rd-stat-card"><small>Total enrolments</small><div class="num">@counts.Values.Sum()</div></div></div>
        <div class="col-md-4"><div class="rd-stat-card"><small>Next event</small><div class="num" style="font-size: 2rem;">@(upcoming == null ? "None planned" : upcoming.Date.ToString("dd MMM yyyy"))</div></div></div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rd-panel text-center">
            <h4>You have not created an event yet</h4>
            <a class="btn btn-rd" asp-action="CreateEvent">Create your first event</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Event</th><th>Date</th><th>Status</th><th>Enrolments</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.Name</td>
                            <td>@e.Date.ToString("dd MMM yyyy")</td>
                            <td>@e.EventStatus</td>
                            <td>@counts[e.EventId]</td>
                            <td><a asp-action="Enrolments" asp-route-id="@e.EventId">View enrolments</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
