@using RaceDay.Web.Models
@model List<EnrolmentInfo>
@{
    var ev = (EventInfo)ViewBag.Event;
    ViewData["Title"] = "Enrolments";
}
<div class="container py-4">
    <a asp-action="Events" class="text-decoration-none">&larr; My Events</a>
    <p class="rd-label mt-3">@ev.Name</p>
    <h1 class="mb-4">Enrolments</h1>

    @if (Model.Count == 0)
    {
        <div class="rd-panel text-center"><p class="mb-0">Nobody has enrolled yet.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Change status</th></tr></thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.ParticipantName</td>
                            <td>@e.CategoryName</td>
                            <td><partial name="_StatusBadge" model="e.StatusName" /></td>
                            <td>
                                <form asp-action="ChangeStatus" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                    <input type="hidden" name="eventId" value="@ev.EventId" />
                                    <select name="statusId" class="form-select form-select-sm" aria-label="New status" asp-items="@(new SelectList(Lookups.EnrolmentStatuses, "Key", "Value", e.StatusId))"></select>
                                    <button type="submit" class="btn btn-sm btn-rd">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
